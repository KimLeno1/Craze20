# ==============================================================================
# Closet Kraze Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Default Admin Credentials 
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@closetkraze.top
ADMIN_PASS=changeme123!

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_key_here
REFRESH_SECRET=your_jwt_refresh_secret_here

# ------------------------------------------------------------------------------
# Payment Gateways
# ------------------------------------------------------------------------------

# Paystack
PAYSTACK_SECRET=sk_test_...
VITE_PAYSTACK_PUBLIC_KEY=pk_test_...

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# ------------------------------------------------------------------------------
# Email Configuration (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ------------------------------------------------------------------------------
# AI Integrations
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
HF_TOKEN=your_huggingface_token_here # Optional for prioritized Gradio try-on queue

# ------------------------------------------------------------------------------
# Scraper Configuration
# ------------------------------------------------------------------------------
SCRAPER_API_KEY=your_scraper_api_key_here
# Comma-separated list of proxy endpoints for rotation
SCRAPER_PROXY_URLS=https://api.scraperapi.com,https://proxy.example.com
BRIGHTDATA_API_TOKEN=your_brightdata_api_token_here
BRIGHTDATA_COLLECTOR_ID=c_1abc2def

# ------------------------------------------------------------------------------
# Database Configurations 
# ------------------------------------------------------------------------------
# Note: Currently primarily using SQLite (database.sqlite)
# Optional fallback if moving to MySQL/Postgres in the future
DB_HOST="localhost"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="closet_kraze"